---
import './stylepos.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Opciones de Pago | NexusTech</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="stylesheet" href="stylepos.css" />
  </head>
  <body>
    <!-- Hero con imagen de fondo -->
    <header class="background-image">
      <div class="title-container">
        <h1 class="title">Planes de Suscripción</h1>
        <p class="subtitle">Elige el plan ideal para tu negocio</p>
		
      </div>
    </header>

    <!-- Imagen central -->
    <section>
      <img
        src="/img/retrato-hombre-guapo-sonriente-anteojos.png"
        alt="Asesor de soporte NexusTech"
        class="centered-image"
      />
    </section>

    <!-- Tarjetas de precios -->
    <main class="card-container" id="planes">
      <!-- MENSUAL -->
      <article class="card">
        <h2><img src="/icons/calendar.svg" alt="" width="20" /> Pago Mensual</h2>
        <p class="price">$80.000</p>
        <ul>
          <li>👥 Sin límite de usuarios</li>
          <li>🌐 Acceso online y soporte técnico (1 mes)</li>
          <li>⚠️ No incluye costos de instalación</li>
          <li>🎓 Capacitación virtual personalizada</li>
          <li>🧾 Facturación electrónica POS</li>
        </ul>
        <a href="https://wa.me/573202594521?text=Hola,%20me%20interesa%20el%20plan%20mensual">
          <button>Comprar</button>
        </a>
      </article>

      <!-- ANUAL -->
      <article class="card">
        <h2><img src="/icons/calendar-check.svg" alt="" width="20" /> Pago Anual</h2>
        <p class="price">$720.000</p>
        <p class="description">Valor mensual $60.000</p>
        <ul>
          <li>👥 Sin límite de usuarios</li>
          <li>🛠️ Soporte técnico por 1 año</li>
          <li>🆓 Instalación gratis</li>
          <li>🎓 Capacitación virtual personalizada</li>
          <li>🧾 Facturación electrónica POS</li>
        </ul>
        <a href="https://wa.me/573202594521?text=Hola,%20me%20interesa%20el%20plan%20anual">
          <button>Comprar</button>
        </a>
      </article>

      <!-- ÚNICO -->
      <article class="card">
        <h2><img src="/icons/shield-check.svg" alt="" width="20" /> Pago Único</h2>
        <p class="price">$1'990.000</p>
        <ul>
          <li>👥 Sin límite de usuarios</li>
          <li>♾️ Acceso sin límite de tiempo</li>
          <li>🛠️ Soporte técnico por 1 año</li>
          <li>💻 Instalación en tu equipo</li>
          <li>🎓 Capacitación virtual personalizada</li>
          <li>🖥️ Multi-equipo en red local</li>
        </ul>
        <a href="https://wa.me/573202594521?text=Hola,%20me%20interesa%20el%20plan%20unico%20pago">
          <button>Comprar</button>
        </a>
      </article>
    </main>

    <!-- Volver -->
    <section class="back-link">
      <a href="/">← Volver a NexusTech</a>
    </section>

    <!-- Footer con contacto -->
    <footer class="final">
      <div>
        <h2 class="subtitle subtfinal">¿Tienes alguna pregunta?</h2>
        <p class="description descfinal">
          Contáctanos y resolveremos tus dudas lo antes posible.
        </p>
        <div class="contact-info">
          <p>📧 <strong>Email:</strong> info@nexus-tech.co</p>
          <p>📱 <strong>Teléfono:</strong> +57 320 259 4521</p>
        </div>
      </div>
      <div class="footer">
        <p>© 2025 NexusTech. Todos los derechos reservados.</p>
      </div>
    </footer>
  </body>
</html>
